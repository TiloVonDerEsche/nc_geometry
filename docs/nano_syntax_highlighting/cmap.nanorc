## Syntax highlighting for C and C++ files.

syntax c "\.cmap$"
header "-\*-.*\<C(\+\+)?((;|[[:blank:]]).*)?-\*-"
magic "^(C|C\+\+) (source|program)"
comment "//"

# Constants.
color brightred "\<[A-Z_][0-9A-Z_]*\>"

# Labels.
color brightmagenta "^[[:blank:]]*[A-Z_a-z][0-9A-Z_a-z]*:[[:blank:]]*$"
color normal ":[[:blank:]]*$"

color brightred "[[:alpha:]_][[:alnum:]_]*[[:blank:]]*="

# Valid Parameters (Overlays bright yellow for correct parameter names)
# Add or remove parameter names inside the list using the '|' separators
#color.cmap
color green "B|C|G"
color green "t_id"
color green "t_start_x|t_start_y|t_start_z"
color green "t_end_x|t_end_y|t_end_z"
color green "machine_speed|laser_power|laser_status"
color green "vradius|hradius"
color green "=|==|!=|<=|<|>=|>"

# Single-quoted stuff (characters, backslash escapes, hex and octal byte codes).
color brightmagenta "'([^'\]|\\(["'\abfnrtv]|x[[:xdigit:]]{1,2}|[0-3]?[0-7]{1,2}))'"


# Strings
color brightyellow ""([^"]|\\")*""

# Integers (e.g., 1, 10, 255)
color yellow "\<[0-9]+\>"

# Floats (e.g., 0.30, 0.02)
color yellow "\<[0-9]+\.[0-9]+\>"

# Equal Sign
color white "(=|==|!=|<=|<|>=|>|\+|-|\*|\^)"

# Brackets & Delimiters
color white "[\{\};,]"

# Comments.
color brightblue "//.*"
color brightblue start="/\*" end="\*/"

# Reminders.
color brightwhite,yellow "\<(NOTE|TODO|DEL|HELP)\>"

# Trailing whitespace.
color ,green "[[:space:]]+$"
